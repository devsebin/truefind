    "@types/cors": "^2.8.19",
    "@types/exceljs": "^1.3.2",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.1",
    "@types/useragent": "^2.3.4",
    "copyfiles": "^2.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3"
  },
