{
  "name": "nodejs-api-from-scratch",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "nodemon ./src/app.ts",
    "g:base": "node ./scripts/db-base-generator.js ",
    "start:replica": "start start-replica.bat",
    "dev": "tsc-watch --onSuccess \"node ./dist/app.js\"",
    "build": "tsc && npm run copy-templates",
    "postinstall": "npm run build",
    "seed:data": "ts-node -r tsconfig-paths/register src/utils/seeder/data-seeder.ts",
    "seed:api": "ts-node -r tsconfig-paths/register src/utils/seeder/api-seeder.ts",
    "export:postman": "node dist/utils/seeder/postman-collection-generator.js",
    "copy-templates": "copyfiles -u 1 src/utils/templates/**/* dist/",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
